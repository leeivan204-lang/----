# .env 檔案範例

# 應用程式名稱
VITE_APP_TITLE="特教/輔導工作紀錄平台"

# 預設身分選項 (以逗號分隔，對應：導師, 個管, 心評, 其他)
VITE_USER_ROLES="導師,個管,心評,其他"

# Google 日曆預設地點 (可選)
VITE_DEFAULT_LOCATION="輔導室/線上會議"

# 功能開關：是否啟用歷史紀錄功能 (true/false)
VITE_ENABLE_HISTORY=true

# 版本號
VITE_APP_VERSION="v3.0-backend"

# [Backend] Server Port
PORT=8000
